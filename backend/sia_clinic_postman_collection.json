  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "66cb5d496a79e4d588000001",
      "type": "string"
    },
    {
      "key": "queueId",
      "value": "66cb5d496a79e4d588000002",
      "type": "string"
    },
    {
      "key": "prescriptionId",
      "value": "66cb5d496a79e4d588000003",
      "type": "string"
