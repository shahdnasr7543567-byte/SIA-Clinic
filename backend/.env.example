PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/sia_clinic
JWT_SECRET=super_secret_sia_clinic_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
CLINIC_DEFAULT_CAPACITY=50

# Firebase Phone Auth Service Account (Keep private, never commit secret keys)
FIREBASE_PROJECT_ID=sia-clinic
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sia-clinic.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
